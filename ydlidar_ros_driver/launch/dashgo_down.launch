<launch>
  <node name="ydlidar_lidar_publisher" pkg="ydlidar_ros_driver" type="ydlidar_ros_driver_node" output="screen">
    <param name="port" type="string" value="/dev/port4"/>
    <param name="frame_id" type="string" value="laser_frame_2"/>
    <param name="baudrate" type="int" value="230400"/>
    <param name="lidar_type" type="int" value="1"/>
    <param name="device_type" type="int" value="0"/>
    <param name="angle_min" type="double" value="-60"/>
    <param name="angle_max" type="double" value="60"/>
    <param name="range_min" type="double" value="0.1"/>
    <param name="range_max" type="double" value="16.0"/>
    <param name="resolution_fixed" type="bool" value="true"/>
    <param name="reversion" type="bool" value="true"/>
    <remap from="scan" to="scan_2"/>
  </node>
  <node pkg="tf" type="static_transform_publisher" name="base_link_to_laser4_2"
        args="0.17 0.0 0.05 -3.04 3.14 0.0 /base_footprint /laser_frame_2 40"/>
</launch>
